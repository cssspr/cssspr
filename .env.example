# ============================================================
# انسخ هذا الملف إلى .env وعبّئ القيم الحقيقية قبل التشغيل.
# لا تضع القيم الحقيقية أبداً داخل الكود أو في نظام التحكم بالإصدارات.
# ============================================================

# قاعدة البيانات (PostgreSQL)
DATABASE_URL="postgresql://amn_user:CHANGE_ME@localhost:5432/amn_portal?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# أنشئ قيمة عشوائية قوية بالأمر: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# بيانات إنشاء حساب المدير الأولي (تُستخدم فقط عند تشغيل npm run create-admin)
ADMIN_NAME="مدير المفوضية"
ADMIN_EMAIL="admin@example.gov.sd"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# حساب المدير (يُستخدم مع npm run reset-admin)
ADMIN_USERNAME="gabril"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# ⚠️ دخول تجريبي بلا اسم مستخدم أو كلمة سر — جهازك فقط أثناء npm run dev.
# مقفل بشرطين معاً في الكود: NODE_ENV != "production" (Vercel/Next تضبطها
# تلقائياً لـ "production" في أي نشر حقيقي، بصرف النظر عن هذا الملف)، وهذا
# المتغير = true. لا يمكن أن يعمل هذا أبداً على نشر فعلي مهما حصل.
DEV_LOGIN_BYPASS="false"

# رمز دخول المدير (الدخول بالرمز فقط، بلا اسم مستخدم). الافتراضي 11223344 إن تُرك فارغاً.
ADMIN_LOGIN_CODE="11223344"

# رفع الصور والملفات:
#  - بدون المتغيرات S3_* أدناه يُحفظ كل شيء محلياً في UPLOAD_DIR ويُخدَم من /uploads (مناسب للتشغيل المحلي
#    وللسيرفر الذي له قرص دائم). على Vercel (قرص للقراءة فقط) استخدم S3 حتماً.
# UPLOAD_DIR="./storage/uploads"
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="https://cdn.example.com"
# حدود حجم الملف المرفوع بالبايت لكل نوع (الافتراضي: صورة 15MB · PDF 25MB · فيديو 100MB)
# MAX_IMAGE_BYTES=15728640
# MAX_PDF_BYTES=26214400
# MAX_VIDEO_BYTES=104857600

# رابط الموقع العام (للـ sitemap وخلاصة RSS ووسوم المشاركة)
# SITE_URL="https://www.amn-ijtimaei.gov.sd"
